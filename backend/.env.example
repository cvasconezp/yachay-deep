# Copiar como .env y completar los valores

# Base de datos (Railway provee DATABASE_URL automáticamente en producción)
DATABASE_URL=postgresql://user:password@host:5432/yachay_db
# Para desarrollo local usar SQLite:
# DATABASE_URL=sqlite:///./yachay.db

# JWT (generar con: openssl rand -hex 32)
SECRET_KEY=genera-una-clave-secreta-con-openssl-rand-hex-32

# Usuario admin inicial
ADMIN_EMAIL=cvasconezp@gmail.com
ADMIN_PASSWORD=TuPasswordSegura2024!

# AVAC scraping credentials (login via Microsoft SSO)
# AVAC_USERNAME = correo institucional UPS (ej: usuario@ups.edu.ec)
# AVAC_PASSWORD = App Password de Microsoft (NO la contraseña normal)
#   Crear en: https://mysignins.microsoft.com/security-info → "Contraseña de aplicación"
#   El App Password salta el MFA automáticamente.
AVAC_USERNAME=tu_correo@ups.edu.ec
AVAC_PASSWORD=tu_app_password_de_microsoft
AVAC_BASE_URL=https://avac.ups.edu.ec/grado68

# Rutas de datos (ajustar en producción)
DATA_PATH_INGRESOS=./data/IngresosAVAC
DATA_PATH_TAREAS=./data/Tareas
DATA_PATH_CALIFICACIONES=./data/calificaciones.csv
DATA_PATH_CALIFICACIONES_HISTORICO=./data/TableauHistorico
DATA_PATH_REPORTE=./data/Reportes
DATA_PATH_DATOS_ESPECIFICOS=./data/DatosEspecificos

# CORS - URL del frontend en Vercel
CORS_ORIGINS=["http://localhost:3000","https://yachay-deep.vercel.app"]
