# Frontend development Dockerfile
# Referenced by docker-compose.yml service "frontend"

FROM node:18-alpine

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Source is mounted as volume in docker-compose.yml
COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
